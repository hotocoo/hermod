{
  "name": "hermod",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/gen-licenses.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:devhost": "cargo build -p hermodr --features devhost --bin hermod-devhost",
    "test:e2e": "npm run build:devhost && playwright test",
    "shots": "npm run build:devhost && SHOTS=1 playwright test e2e/shots.spec.ts",
    "test:unit": "vitest run",
    "perf:scene": "node scripts/perf-scene.mjs",
    "perf:hidden": "node scripts/hidden-cpu.mjs",
    "tauri": "tauri",
    "assets:fetch": "node scripts/assets/fetch.mjs",
    "assets:blender": "node scripts/assets/blender/run.mjs",
    "assets:build": "node scripts/assets/fetch.mjs && node scripts/assets/blender/run.mjs && node scripts/assets/build.mjs && node scripts/assets/rooms/bake.mjs",
    "assets:build:high": "node scripts/assets/build.mjs --tier high",
    "assets:rooms": "node scripts/assets/rooms/bake.mjs",
    "assets:art": "node scripts/assets/rooms/art.mjs",
    "assets:ultra:link": "node scripts/assets/ultra-link.mjs",
    "assets:turntables": "node scripts/assets/turntables.mjs",
    "assets:check": "node scripts/assets/check.mjs --tier both"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-deep-link": "^2.6.2",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "three-gpu-pathtracer": "0.0.24",
    "three-mesh-bvh": "0.9.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@noble/hashes": "^2.4.0",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "fflate": "^0.8.3",
    "ktx2-encoder": "^0.6.0",
    "meshoptimizer": "^1.3.0",
    "raw-loader": "^4.0.2",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
