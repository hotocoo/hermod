[Unit]
Description=Hermod relay and bootstrap peer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=hermod-node
ExecStart=/usr/local/bin/hermod-node --data-dir /var/lib/hermod-node --relay auto
Restart=on-failure
RestartSec=5
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
