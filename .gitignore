# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/target
/design-src

# playwright
/playwright-report/
/test-results/

# release hygiene
target/
/out/
.next/
node_modules/
*.key
.env*
/playwright-report/
/test-results/
design-src/
/src-tauri/gen/
.e2e-site-*/
test-results-*/
playwright-report-*/

# asset pipeline
/assets/cache/
/dist-assets/
/.cache/
perf-results/

# ultra asset pack link for dev (scripts/assets/ultra-link.mjs)
/public/assets/ultra

# local dev/tool caches
/.next-*/
*.log
/.serena/cache/
/.serena/project.local.yml

# frontend asset folders moved out of out/ at release build (scripts/split-web-assets.mjs)
/src-tauri/web/*
!/src-tauri/web/.gitkeep

# python bytecode
__pycache__/

# local agent worktrees and parallel build dirs
/.claude/worktrees/
/target-wf/
