{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hermod",
  "version": "0.1.0",
  "identifier": "io.github.hotocoo.hermod",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && node scripts/split-web-assets.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Hermod",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: hermod-blob: http://hermod-blob.localhost; media-src 'self' data: blob: hermod-blob: http://hermod-blob.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost hermod-blob: http://hermod-blob.localhost; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "web/": "web/"
    },
    "linux": {
      "deb": {
        "depends": ["libdbus-1-3"]
      },
      "rpm": {
        "depends": ["dbus-libs"]
      }
    },
    "createUpdaterArtifacts": true,
    "category": "SocialNetworking",
    "copyright": "Copyright 2026 The Hermod contributors",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "homepage": "https://hotocoo.github.io/hermod/",
    "publisher": "The Hermod contributors",
    "shortDescription": "Peer-to-peer spaces for people",
    "longDescription": "Hermod is a desktop app where every install is a small peer in an encrypted mesh. No central server."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "hermod"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxOUI5Q0Q5MjE3OEIyRkUKUldUK3NuZ2gyWnliVVdia2RTd3JwaXFKZER6VmlxWnRhT1greElCVWtiTjlaMU5yQk5TSXFPcm8K",
      "endpoints": [
        "https://github.com/hotocoo/hermod/releases/latest/download/latest.json"
      ]
    }
  }
}
